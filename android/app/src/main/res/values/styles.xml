<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Themes -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- Today Schedule Widget Typography Styles -->
    <style name="WidgetTodaySchedule" />

    <style name="WidgetTodaySchedule.Title">
        <item name="android:textSize">@dimen/widget_text_size_title</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetTodaySchedule.Empty">
        <item name="android:textSize">@dimen/widget_text_size_body</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="WidgetTodaySchedule.Pair">
        <item name="android:textSize">@dimen/widget_text_size_pair</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetTodaySchedule.Time">
        <item name="android:textSize">@dimen/widget_text_size_caption</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
    </style>

    <style name="WidgetTodaySchedule.ItemTitle">
        <item name="android:textSize">@dimen/widget_text_size_body</item>
        <item name="android:textColor">@color/widget_text_primary</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetTodaySchedule.ItemMeta">
        <item name="android:textSize">@dimen/widget_text_size_caption</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>